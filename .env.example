# DRAGO Predictor Backend — Environment Variables Template (PR-7)
# Copy to .env and fill with real production secrets (NEVER commit .env)

PORT=10000
PUBLIC_BASE_URL=https://dragopredictor.onrender.com
FRONTEND_URL=https://dragopredictor.vercel.app
ALLOWED_WEB_DOMAIN=dragopredictor.vercel.app

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=drago

# Authentication & Request Signing
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
JWT_SECRET=<64-byte-random-hex-secret>
JWT_EXPIRES_IN=7d
APP_ID=drago_app_0395eb947a3dc407
APP_SECRET=<64-byte-random-hex-secret>

# Upstream Prediction / History VPS
WINGO_PREDICTION_URL=https://<your-vps-host>/wingo30s_prediction
WINGO_HISTORY_URL=https://<your-vps-host>/wingo30s_history
VPS_SECRET=<your-vps-shared-secret>

# Payment Configuration
UPI_ID=<your-merchant-upi-id>
QR_URL_749=https://i.ibb.co/<weekly-qr-image>
QR_URL_1498=https://i.ibb.co/<monthly-qr-image>
RUPAYEX_API_TOKEN=<your-rupayex-api-token>
RUPAYEX_API_BASE=https://rupayex.com/api

# Telegram Bots & Image Upload
TELEGRAM_BOT_TOKEN=<admin-telegram-bot-token>
TELEGRAM_ADMIN_CHAT_ID=<admin-telegram-user-id>
TELEGRAM_GROUP_BOT_TOKEN=<group-report-bot-token>
TELEGRAM_REPORT_GROUP_ID=<group-chat-id>
TELEGRAM_WEBHOOK_SECRET=<webhook-secret-token>
IMGBB_API_KEY=<your-imgbb-api-key>
