# ═══ Render Environment Variables (copy to Render Dashboard → Environment) ═══

PORT=3000

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT — min 32 characters (use: openssl rand -hex 32)
JWT_SECRET=357861ffb0e7b096e19cd8c7cfc3ccb60d0f1a4fffe18d2977b308fbb41d5e0c
JWT_EXPIRES_IN=7d

# App identity + HMAC signing (same values on Vercel as DRAGO_APP_ID / DRAGO_APP_SECRET)
APP_ID=drago_app_0395eb947a3dc407
APP_SECRET=357861ffb0e7b096e19cd8c7cfc3ccb60d0f1a4fffe18d2977b308fbb41d5e0c

# Frontend
FRONTEND_URL=https://dragopredictor.vercel.app
ALLOWED_WEB_DOMAIN=dragopredictor.vercel.app

# MongoDB Atlas (NO credentials in source code)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/drago?retryWrites=true&w=majority

# Prediction VPS (server-to-server only — never sent to browser)
WINGO_PREDICTION_URL=http://46.247.108.191:30296/api/prediction/wingo/30s/size

# Optional public HTTPS base of THIS Render service (for Google OAuth callback)
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com

# Rupayex payment
RUPAYEX_API_BASE=https://rupayex.net/api
RUPAYEX_API_TOKEN=

# Manual QR plan images
QR_URL_300=
QR_URL_500=
QR_URL_900=

# Telegram admin
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional history source (defaults to official draw API)
# WINGO_HISTORY_URL=https://draw.ar-lottery01.com/WinGo/WinGo_30S/GetHistoryIssuePage.json
