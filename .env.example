# DRAGO main backend — sample only. Never commit real .env values.
# Required variables must be provisioned in Render's secret environment.

PORT=10000
PUBLIC_BASE_URL=https://dragopredictor.onrender.com
FRONTEND_URL=https://dragopredictor.vercel.app
ALLOWED_WEB_DOMAIN=dragopredictor.vercel.app

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=drago

# Authentication and server-side encryption
GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
JWT_SECRET=<at-least-32-random-bytes-hex>
JWT_EXPIRES_IN=24h
APP_ID=drago_app_0395eb947a3dc407
APP_SECRET=<at-least-32-random-bytes-hex>
# Set only during a key rotation; remove after encrypted records are re-encrypted.
APP_SECRET_PREV=<old-app-secret-temporary>

# Upstream prediction/history VPS
WINGO_PREDICTION_URL=https://<your-vps-host>/wingo30s_prediction
WINGO_HISTORY_URL=https://<your-vps-host>/wingo30s_history
VPS_SECRET=<at-least-32-random-bytes-hex-shared-with-prediction-vps>

# Payment configuration
UPI_ID=<merchant-upi-id>
QR_URL_749=https://i.ibb.co/<weekly-qr-image>
QR_URL_1498=https://i.ibb.co/<monthly-qr-image>
RUPAYEX_API_TOKEN=<server-side-rupayex-api-token>
RUPAYEX_API_BASE=https://rupayex.com/api

# Telegram — use distinct tokens for distinct bots; never put these in PUBLIC_* vars.
TELEGRAM_ADMIN_BOT_TOKEN=<admin-botfather-token>
TELEGRAM_FREE_BOT_TOKEN=<free-verification-botfather-token>
TELEGRAM_GROUP_BOT_TOKEN=<group-report-bot-token>
# Legacy admin/group alias accepted during migration; remove after explicit vars are set.
TELEGRAM_BOT_TOKEN=<legacy-admin-or-group-bot-token>
TELEGRAM_ADMIN_CHAT_ID=<admin-chat-id>
TELEGRAM_REPORT_GROUP_ID=<report-group-id>
TG_CHANNEL_ID=<free-verification-channel-id>
TG_OWNER_CHAT=<owner-chat-id>
TG_JOIN_LINK=<free-verification-channel-invite-url>
TG_BOT_USERNAME=<free-verification-bot-username>
TG_FREE_SECRET=<at-least-32-random-bytes-hex-kept-only-on-render>
TELEGRAM_WEBHOOK_SECRET=<32-to-64-hex-characters-configured-with-telegram-setWebhook>

# Web Push (public key may be visible; private key must remain in Render only)
VAPID_PUBLIC_KEY=<base64url-vapid-public-key>
VAPID_PRIVATE_KEY=<base64url-vapid-private-key>

# Admin API secret: high-entropy random secret; do not embed in admin HTML/source.
ADMIN_PANEL_KEY=<at-least-32-random-bytes>

# Optional server-side image hosting key (IMGBB_KEY accepted as legacy alias)
IMGBB_API_KEY=<imgbb-api-key>
