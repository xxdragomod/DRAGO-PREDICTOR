# ═══════════════════════════════════════════════════════════════════════════
#  DRAGO PREDICTOR — environment variables
#
#  Har deployment value yahan se aati hai. Code me koi fallback nahi.
#  `<REQUIRED>` wale missing hone par server boot hi nahi hoga (fail fast),
#  taaki galti se galat chat / UPI / VPS use na ho.
#
#  Render → Environment → yahan se copy karo.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ─── Public URLs & origins ─────────────────────────────────────────────────
# REQUIRED — frontend ka public URL (OAuth redirect, CORS, QR, push icons)
FRONTEND_URL=https://dragopredictor.vercel.app
# REQUIRED — browser requests ke liye allowed hostname (FRONTEND_URL se derive hota hai)
ALLOWED_WEB_DOMAIN=dragopredictor.vercel.app
# Optional — uploaded image URLs ka fixed base (khaali = request se auto-detect)
PUBLIC_BASE_URL=https://dragopredictor.onrender.com
# Optional — extra allowed browser origins (comma-separated)
CORS_EXTRA_ORIGINS=
# Optional — local dev origins (sirf jab NODE_ENV=production na ho)
DEV_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ─── Database ──────────────────────────────────────────────────────────────
# REQUIRED
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=drago

# ─── Auth & encryption ─────────────────────────────────────────────────────
# REQUIRED — Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-client-secret>
# REQUIRED — 32+ random chars
JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRES_IN=24h
# REQUIRED — client signing (APP_SECRET 32+ chars)
APP_ID=drago_app_<your-app-id>
APP_SECRET=<at-least-32-random-characters>
# Optional — key rotation ke waqt
APP_ID_PREV=
APP_SECRET_PREV=

# ─── Upstream prediction/history VPS ───────────────────────────────────────
# REQUIRED
WINGO_PREDICTION_URL=https://<your-vps-host>/api/prediction/wingo/30s/size
WINGO_HISTORY_URL=https://<your-vps-host>/api/history
VPS_SECRET=<at-least-32-random-characters-shared-with-vps>
# Optional tuning
WINGO_HISTORY_MAX=10000
MARKET_CACHE_TTL_MS=2000

# ─── Payments ──────────────────────────────────────────────────────────────
# REQUIRED — merchant UPI id
UPI_ID=<merchant-upi-id>
# REQUIRED — gateway base url
RUPAYEX_API_BASE=https://rupayex.net/api
RUPAYEX_API_TOKEN=<rupayex-api-token>
ORDER_ID_PREFIX=DRAGO
PAYMENT_TTL_MS=600000
# QR images (admin panel se override hoti hain, ye fallback hai)
QR_URL_749=
QR_URL_1498=
# QR fallback images (jab admin setting aur QR_URL dono khaali hon)
QR_FALLBACK_WEEKLY_URL=https://dragopredictor.vercel.app/assets/upi/qr-weekly.png
QR_FALLBACK_MONTHLY_URL=https://dragopredictor.vercel.app/assets/upi/qr-monthly.png
# Purane/expired QR asset ids jo reject karne hain (regex, '|' se separated)
QR_REJECT_PATTERN=dc0e2bd33bc2|47c3bf9c834f|spLnbMnw|Ngw5tH5j|ZzZvmHB2|5h7CFYrK|upipe-qr

# ─── Plans (defaults — admin panel se runtime override) ────────────────────
PLAN_WEEKLY_NAME=PRO VIP WEEKLY
PLAN_WEEKLY_AMOUNT=749
PLAN_WEEKLY_DAYS=7
PLAN_MONTHLY_NAME=PRO VIP MONTHLY
PLAN_MONTHLY_AMOUNT=1498
PLAN_MONTHLY_DAYS=30

# ─── Free tier limits (defaults — admin panel se override) ─────────────────
FREE_PRED_LIMIT=3
FREE_API_HISTORY_LIMIT=10
FREE_NEXUS_LIMIT=3

# ─── Telegram — admin bot (payment approve/deny) ───────────────────────────
# REQUIRED
TELEGRAM_ADMIN_BOT_TOKEN=<admin-bot-token>
TELEGRAM_ADMIN_CHAT_ID=<your-telegram-user-id>
TELEGRAM_REPORT_GROUP_ID=<report-group-id-negative>
# Optional — alag group bot (fallback: admin bot)
TELEGRAM_GROUP_BOT_TOKEN=
# Legacy alias (migration ke baad hata do)
TELEGRAM_BOT_TOKEN=

# ─── Telegram — free-plan verification bot (optional feature) ──────────────
TELEGRAM_FREE_BOT_TOKEN=<free-bot-token>
TG_CHANNEL_ID=<free-channel-id-negative>
TG_OWNER_CHAT=<owner-chat-id>
TG_JOIN_LINK=https://t.me/+<invite-hash>
TG_BOT_USERNAME=<free-bot-username>
TG_FREE_SECRET=<32-plus-random-characters>
TELEGRAM_WEBHOOK_SECRET=<32-to-64-hex-characters>

# ─── Web push (VAPID) ──────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=<base64url-vapid-public-key>
VAPID_PRIVATE_KEY=<base64url-vapid-private-key>
# VAPID contact (push service ke liye) — REQUIRED jab web-push installed ho
SUPPORT_EMAIL=support@dragopredictor.vercel.app
PUSH_ICON_PATH=/favicon-192.png
PUSH_ICON_VERSION=20261004

# ─── Admin panel ───────────────────────────────────────────────────────────
# REQUIRED — 32+ random chars
ADMIN_PANEL_KEY=<at-least-32-random-characters>

# ─── Branding & default assets ─────────────────────────────────────────────
BRAND_NAME=DRAGO Predictor
BRAND_EMOJI=🐉
# GET / health message ka short label
API_STATUS_LABEL=DRAGO
# Default banner (admin panel se override)
DEFAULT_BANNER_TITLE=DRAGO Predictor RX1 Model
DEFAULT_BANNER_IMAGE=/assets/images/banners/rx1-model-feature.webp
DEFAULT_BANNER_LINK=/prediction/

# ─── Security tuning ───────────────────────────────────────────────────────
# Frontend ke saath shared telemetry salt (auth isse nahi hoti)
SHIELD_SALT=DRAGO_SHIELD_V2_8kq2
SIGNATURE_MAX_SKEW_MS=120000
NONCE_TTL_MS=300000
OAUTH_STATE_TTL_MS=600000

# ─── Rate limits & body sizes ──────────────────────────────────────────────
RATE_LIMIT_PER_IP=240
RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT=20
API_RATE_WINDOW_MS=60000
API_KEY_LIMIT=5
API_KEY_PREFIX=drago_
JSON_BODY_LIMIT=256kb
JSON_UPLOAD_LIMIT=8mb
UPLOAD_MAX_BYTES=6291456

# ─── Optional image host ───────────────────────────────────────────────────
IMGBB_API_KEY=
