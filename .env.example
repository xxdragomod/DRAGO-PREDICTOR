# ═══ Render Environment Variables (copy to Render Dashboard → Environment) ═══
# ⚠️ SECURITY: ye file sirf TEMPLATE hai — real secrets yahan COMMIT MAT karo.
# Purane committed values (JWT/APP/VPS secret) LEAKED hain → naye generate karo.

PORT=3000

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT — min 32 characters (use: openssl rand -hex 32)
# NOTE: JWT_SECRET aur APP_SECRET ALAG-ALAG values rakho!
JWT_SECRET=
JWT_EXPIRES_IN=7d

# App identity + HMAC signing (Vercel pe DRAGO_APP_ID mat jodna — sirf Render env me)
APP_ID=
APP_SECRET=

# Frontend
FRONTEND_URL=https://dragopredictor.vercel.app
ALLOWED_WEB_DOMAIN=dragopredictor.vercel.app

# MongoDB Atlas (NO credentials in source code)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/drago?retryWrites=true&w=majority

# Orihost VPS — prediction + history (Render stores neither; only proxies)
WINGO_PREDICTION_URL=http://46.247.108.191:30296/api/prediction/wingo/30s/size
WINGO_HISTORY_URL=http://46.247.108.191:30296/api/history
VPS_SECRET=

# Public HTTPS base of THIS Render service (Google OAuth callback)
PUBLIC_BASE_URL=https://dragopredictor.onrender.com

# Rupayex payment
RUPAYEX_API_BASE=https://rupayex.net/api
RUPAYEX_API_TOKEN=

# Manual QR plan images
QR_URL_300=
QR_URL_500=
QR_URL_900=

# Telegram admin
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional history source (defaults to official draw API)
# WINGO_HISTORY_URL=https://draw.ar-lottery01.com/WinGo/WinGo_30S/GetHistoryIssuePage.json
